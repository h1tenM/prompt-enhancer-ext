venv 
# --- Environment / Secrets ---
.env
*.env
.venv/
env/
venv/
ENV/

# --- Python / Backend ---
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
backend/api_key_test.py

# --- Vector Database & Local Data ---
# We keep the 'db' folder structure but ignore the actual data files 
# to ensure everyone starts with a fresh or controlled index.
backend/db/*.sqlite3
backend/db/**/*.bin
# Locally-added research docs; the manifest is per-user state, not source.
backend/db/docs.json

# --- Eval ---
# Downloaded benchmark datasets. results/ IS tracked: those numbers are the
# evidence behind the README's claims.
backend/eval/.cache/

# --- OS / IDE Junk ---
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.log

# --- Chrome Extension ---
*.pem
*.crx

# --- Random Files ---
notes.txt
